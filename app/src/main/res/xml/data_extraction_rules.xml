<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 以降は allowBackup="false" でも端末間の移行が止まらない機種があるため、どちらも全部除く -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
    </device-transfer>
</data-extraction-rules>
